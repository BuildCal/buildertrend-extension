// Prisma schema for the web app's local data
// (users, sessions, audit log, bill review queue)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----- Auth (next-auth tables) -----

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         UserRole @default(MEMBER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions         UserSession[]
  auditEntries     AuditLogEntry[] @relation("AuditUser")
  reviewedInvoices Invoice[]       @relation("ReviewedBy")
}

enum UserRole {
  ADMIN
  MEMBER
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ----- Bill review queue -----
//
// Bills extracted by Claude land here. A team member reviews each one,
// optionally edits, then approves -> we POST to BT and mark as posted.

model Invoice {
  id                 String @id @default(cuid())
  sourceExtractionId String @unique // idempotency key from extractor

  // Inbound data (what the extractor gave us)
  rawPayload      Json
  vendorNameRaw   String
  jobReferenceRaw String?
  amountTotal     Decimal  @db.Decimal(12, 2)
  invoiceDate     DateTime
  invoiceNumber   String?
  pdfUrl          String? // signed URL to source PDF in object storage

  // Resolved data (after vendor/job/cost-code matching)
  resolvedVendorId Int?
  resolvedJobId    Int?
  resolvedPayload  Json? // BT-shaped payload, ready to post

  // Workflow state
  status       InvoiceStatus @default(EXTRACTED)
  reviewedById String?
  reviewedBy   User?         @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // Result
  btBillId     Int?
  btExternalId String?
  postedAt     DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isExpense          Boolean          @default(false)
  resolvedBtVendorId Int?
  btPurchaseOrderId  Int?
  purchaseOrder      BtPurchaseOrder? @relation(fields: [btPurchaseOrderId], references: [btPurchaseOrderId])
  poMatchStatus      String? // 'exact' | 'under' | 'over' | 'no_po_required'
  poVarianceAmount   Decimal?         @db.Decimal(12, 2)
  poVarianceReason   String?

  subtotal     Decimal? @db.Decimal(12, 2)
  gstAmount    Decimal? @db.Decimal(12, 2)
  gstTreatment String?

  resolvedBtCostCodeId Int?
  filePath             String? // path in Supabase storage

  confidenceScore    Float?
  extractionWarnings Json?

  pmApprovedById       String?
  pmApprovedAt         DateTime?
  directorApprovedById String?
  directorApprovedAt   DateTime?
  rejectionReason      String?

  lineItems    InvoiceLineItem[]
  approvalLogs InvoiceApprovalLog[]

  @@index([status])
  @@index([createdAt])
  @@map("invoices")
}

enum InvoiceStatus {
  PENDING
  EXTRACTED
  IN_REVIEW
  PENDING_PM_APPROVAL
  PENDING_DIRECTOR_APPROVAL
  APPROVED
  POSTING
  POSTED
  REJECTED
  ERROR
}

// ----- Audit log -----

model AuditLogEntry {
  id         String   @id @default(cuid())
  timestamp  DateTime @default(now())
  userId     String?
  user       User?    @relation("AuditUser", fields: [userId], references: [id])
  action     String // e.g. "bill.approve", "bill.post", "session.refresh"
  resourceId String? // PendingBill.id, etc.
  detail     Json // structured data about what happened

  @@index([timestamp])
  @@index([userId])
  @@index([action])
}

// ----- BT session metadata mirror -----
//
// The actual session cookies live in bt-service (encrypted).
// We mirror metadata here so the UI can show status without round-tripping.

model BTSessionStatus {
  id                String    @id @default("singleton")
  isAuthenticated   Boolean   @default(false)
  encryptedCookies  String?
  capturedById      String?
  capturedAt        DateTime?
  lastVerifiedAt    DateTime?
  updatedAt         DateTime  @updatedAt
}

// ----- BT mirrored tables (read-only, refreshed from BT) -----

model BtJob {
  btJobId   Int      @id
  builderId Int
  name      String
  jobNumber String?
  status    String?
  address   String?
  rawHash   String?
  syncedAt  DateTime @default(now())

  purchaseOrders BtPurchaseOrder[]
  bills          BtBill[]

  @@index([builderId])
  @@map("bt_jobs")
}

model BtVendor {
  btVendorId Int      @id
  builderId  Int
  name       String
  email      String?
  phone      String?
  userType   Int? // BT enum: 1=internal, 2=sub/vendor, etc.
  syncedAt   DateTime @default(now())

  profile        VendorProfile?
  purchaseOrders BtPurchaseOrder[]
  bills          BtBill[]

  @@index([builderId])
  @@index([name])
  @@map("bt_vendors")
}

model BtCostCode {
  btCostCodeId Int      @id
  builderId    Int
  btJobId      Int? // cost codes can be job-specific
  code         String
  title        String
  syncedAt     DateTime @default(now())

  @@index([builderId])
  @@index([btJobId])
  @@map("bt_cost_codes")
}

model BtPurchaseOrder {
  btPurchaseOrderId Int       @id
  builderId         Int
  btJobId           Int?
  btVendorId        Int?
  poNumber          String?
  title             String?
  status            String?
  totalAmount       Decimal?  @db.Decimal(12, 2)
  invoicedAmount    Decimal?  @db.Decimal(12, 2)
  issueDate         DateTime?
  rawHash           String?
  syncedAt          DateTime  @default(now())

  job       BtJob?                @relation(fields: [btJobId], references: [btJobId])
  vendor    BtVendor?             @relation(fields: [btVendorId], references: [btVendorId])
  lineItems BtPurchaseOrderLine[]
  bills     BtBill[]
  invoices  Invoice[]

  @@index([builderId])
  @@index([btJobId])
  @@index([btVendorId])
  @@index([status])
  @@map("bt_purchase_orders")
}

model BtPurchaseOrderLine {
  id                String   @id @default(cuid())
  btPurchaseOrderId Int
  description       String
  quantity          Decimal? @db.Decimal(12, 2)
  unitPrice         Decimal? @db.Decimal(12, 2)
  amount            Decimal? @db.Decimal(12, 2)
  btCostCodeId      Int?

  purchaseOrder BtPurchaseOrder @relation(fields: [btPurchaseOrderId], references: [btPurchaseOrderId], onDelete: Cascade)

  @@index([btPurchaseOrderId])
  @@map("bt_purchase_order_lines")
}

model BtBill {
  btBillId          Int  @id
  builderId         Int
  btJobId           Int?
  btVendorId        Int?
  btPurchaseOrderId Int?

  billNumber String?
  billTitle  String?

  paymentAmount Decimal?  @db.Decimal(12, 2)
  invoicedDate  DateTime?
  dueDate       DateTime?
  datePaid      DateTime?
  isPastDue     Boolean   @default(false)

  payToName String?

  // BT's payment status enum: 0=Draft, 1=Approved, 2=Paid, 4/5=Paid variants,
  // 7=Pending, 8=In Review, 9=Draft, etc.
  paymentStatus Int?

  purchaseOrderNumber String?
  rawHash             String?

  syncedAt DateTime @default(now())

  job           BtJob?           @relation(fields: [btJobId], references: [btJobId])
  vendor        BtVendor?        @relation(fields: [btVendorId], references: [btVendorId])
  purchaseOrder BtPurchaseOrder? @relation(fields: [btPurchaseOrderId], references: [btPurchaseOrderId])

  @@index([builderId])
  @@index([btJobId])
  @@index([btVendorId])
  @@index([btPurchaseOrderId])
  @@index([paymentStatus])
  @@index([invoicedDate])
  @@map("bt_bills")
}

// ----- Gateway mirrors (BT is the record; these are copies) -----

model BtLead {
  btLeadId  Int      @id
  builderId Int
  btJobId   Int?
  title     String?
  status    String?
  amount    Decimal? @db.Decimal(12, 2)
  rawHash   String?
  extra     Json?
  syncedAt  DateTime @default(now())

  @@index([builderId])
  @@map("bt_leads")
}

model BtContact {
  btContactId Int      @id
  builderId   Int
  btJobId     Int?
  title       String?
  status      String?
  amount      Decimal? @db.Decimal(12, 2)
  rawHash     String?
  extra       Json?
  syncedAt    DateTime @default(now())

  @@index([builderId])
  @@map("bt_contacts")
}

model BtInvoice {
  btInvoiceId Int      @id
  builderId   Int
  btJobId     Int?
  title       String?
  status      String?
  amount      Decimal? @db.Decimal(12, 2)
  rawHash     String?
  extra       Json?
  syncedAt    DateTime @default(now())

  @@index([builderId])
  @@index([btJobId])
  @@map("bt_invoices")
}

model BtVariation {
  btVariationId Int      @id
  builderId     Int
  btJobId       Int?
  title         String?
  status        String?
  amount        Decimal? @db.Decimal(12, 2)
  rawHash       String?
  extra         Json?
  syncedAt      DateTime @default(now())

  @@index([builderId])
  @@index([btJobId])
  @@map("bt_variations")
}

model BtSyncState {
  id             String    @id @default(cuid())
  entityType     String
  externalId     String
  lastPulledHash String?
  lastPulledAt   DateTime?
  lastPushedAt   DateTime?
  lastError      String?
  updatedAt      DateTime  @updatedAt

  @@unique([entityType, externalId])
  @@index([entityType])
  @@map("bt_sync_state")
}

model BtCommandLog {
  id             String   @id @default(cuid())
  verb           String
  dryRun         Boolean  @default(true)
  payloadSummary Json
  btStatus       Int?
  errorCode      String?
  createdAt      DateTime @default(now())

  @@index([verb])
  @@index([createdAt])
  @@map("bt_command_log")
}

// ----- Our enrichment of BT vendors -----

model VendorProfile {
  btVendorId Int      @id
  vendor     BtVendor @relation(fields: [btVendorId], references: [btVendorId], onDelete: Cascade)

  notes             String?
  defaultCostCodeId Int?
  accountsEmail     String?
  abn               String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases VendorAlias[]

  @@map("vendor_profiles")
}

model VendorAlias {
  id         String        @id @default(cuid())
  btVendorId Int
  profile    VendorProfile @relation(fields: [btVendorId], references: [btVendorId], onDelete: Cascade)
  alias      String

  createdAt DateTime @default(now())

  @@unique([btVendorId, alias])
  @@index([alias])
  @@map("vendor_aliases")
}

// ----- Invoice line items -----

model InvoiceLineItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  lineNumber  Int
  description String
  quantity    Decimal? @db.Decimal(12, 2)
  unitPrice   Decimal? @db.Decimal(12, 2)
  amount      Decimal  @db.Decimal(12, 2)

  btCostCodeId Int?
  btJobId      Int?
  gstTreatment String? // 'inclusive' | 'exclusive' | 'no_gst'
  gstAmount    Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invoiceId])
  @@map("invoice_line_items")
}

// ----- Invoice approval log -----

model InvoiceApprovalLog {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  action      String // 'submitted_for_approval' | 'approved' | 'rejected' | 'escalated' | 'posted'
  actorUserId String?
  notes       String?
  detail      Json?

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_approval_logs")
}
