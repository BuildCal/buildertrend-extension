# --- Database ---
# Local Docker Compose (see docker-compose.yml):
DATABASE_URL=postgresql://bt_user:bt_dev_password@localhost:5432/bt_tools_dev
# Direct (non-pooled) URL. Same as DATABASE_URL for local Docker.
# For Neon / Supabase, use the direct host (not the pooler) here.
DIRECT_URL=postgresql://bt_user:bt_dev_password@localhost:5432/bt_tools_dev

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me
# NextAuth v5 also reads AUTH_SECRET; keep it in sync if you set both.
# AUTH_SECRET=replace-me

# Canonical app URL (used by NextAuth)
NEXTAUTH_URL=http://localhost:3000

# --- bt-service ---
# Where the Python sidecar is running.
BT_SERVICE_URL=http://localhost:8000
# Same value as bt-service INTERNAL_API_TOKEN
BT_SERVICE_INTERNAL_TOKEN=replace-me

# --- Webhook auth ---
# Bearer token for POST /api/webhooks/extracted-bill
# Generate: openssl rand -base64 32
EXTRACTOR_WEBHOOK_SECRET=replace-me

# --- Optional: Claude invoice extraction ---
# Required only for /api/invoices/extract
# ANTHROPIC_API_KEY=

# --- Optional: invoice PDF storage (Supabase Storage) ---
# Required only for upload / signed PDF preview
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-me
# SUPABASE_STORAGE_BUCKET=bill-pdfs
