# --- Database ---
# Postgres for app data (users, queue, audit log).
# Local dev (Docker compose):
DATABASE_URL=postgresql://bt_user:bt_dev_password@localhost:5432/bt_tools_dev

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me

# Used by NextAuth as the canonical app URL
NEXTAUTH_URL=http://localhost:3000

# --- bt-service ---
# Where the Python sidecar is running. Local dev:
BT_SERVICE_URL=http://localhost:8000
# Same secret as bt-service's INTERNAL_API_TOKEN
BT_SERVICE_INTERNAL_TOKEN=replace-me

# --- Webhook auth ---
# Used by your Claude extraction tool to authenticate to /api/webhooks/extracted-bill
# Generate: openssl rand -base64 32
EXTRACTOR_WEBHOOK_SECRET=replace-me
