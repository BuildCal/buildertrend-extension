{
  "name": "gateway",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Buildertrend Gateway — one door for reads and draft writes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bt-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "tsx src/cli.ts mcp",
    "serve": "tsx src/cli.ts serve",
    "capture": "tsx src/cli.ts capture"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "hono": "^4.7.10",
    "pg": "^8.14.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
