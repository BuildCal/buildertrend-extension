# Buildertrend Gateway
# Copy to .env and fill in. Never commit the real file.

# Leave unset (0) until session.status / GlobalInfo returns the signed-in builder id.
# BT_BUILDER_ID=
BT_BASE_URL=https://buildertrend.net

# Send / notify / pay / void / convert-to-job / mark-ready-for-payment.
# Leave false. A named send tool is enabled explicitly, never during setup.
BT_GATEWAY_ENABLE_SEND=false

# Required (with dry_run=false) before creating a real job, lead, or contact.
BT_GATEWAY_SANDBOX=false

# Writes default to dry-run (no network). Set false only when you intend a draft push.
BT_GATEWAY_DEFAULT_DRY_RUN=true

# HTTP API
BT_GATEWAY_PORT=8787
# Generate: openssl rand -base64 32
BT_GATEWAY_TOKEN=replace-me-with-a-long-random-string

# Transport: sidecar (curl-cffi TLS via bt-service) or direct (fetch + cookie jar).
BT_TRANSPORT=sidecar
BT_SERVICE_URL=http://127.0.0.1:8000
BT_SERVICE_INTERNAL_TOKEN=must-match-bt-service-INTERNAL_API_TOKEN

# Direct transport only — JSON cookie jar from the dedicated gateway Chrome profile.
# Never commit this file. Never point this at a human's daily Chrome profile.
# BT_COOKIE_JAR=/var/lib/bt-gateway/cookies.json

# Dedicated Playwright profile for capture. Never the human daily Chrome profile.
# Path must contain bt-gateway / gateway-profile or a .bt-gateway-profile marker.
# BT_GATEWAY_PROFILE=/var/lib/bt-gateway/chrome-profile
# BT_GATEWAY_HUMAN_PROFILE=/home/brad/.config/google-chrome

# Postgres (same DB as the web app / bt-service). Optional — memory store if unset.
# DATABASE_URL=postgresql://bt_user:bt_dev_password@localhost:5432/bt_tools_dev
