# Environment for bt-service
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Generate this once and share with the web app:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must match web app BT_SERVICE_INTERNAL_TOKEN
INTERNAL_API_TOKEN=replace-me-with-a-long-random-string

# Postgres (Docker Compose default). Use the +asyncpg driver.
DATABASE_URL=postgresql+asyncpg://bt_user:bt_dev_password@localhost:5432/bt_tools_dev

# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-me-with-a-fernet-key

# Buildertrend
BT_BASE_URL=https://buildertrend.net
# Your tenant's builder / builderId. Required for mirror sync.
BT_BUILDER_ID=0
