# Environment for bt-service
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# Generate this once and share with the web app: e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=replace-me-with-a-long-random-string

# Postgres connection (Docker compose default values)
DATABASE_URL=postgresql+asyncpg://bt_user:bt_dev_password@localhost:5432/bt_tools_dev

# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace-me-with-a-fernet-key

# Buildertrend
BT_BASE_URL=https://buildertrend.net
BT_BUILDER_ID=110310
