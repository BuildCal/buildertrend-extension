{
  "name": "buildertrend-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Buildertrend bill workflows: extraction, review queue, and API sidecar",
  "license": "MIT",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "lint": "pnpm --filter web lint",
    "typecheck": "pnpm --filter web typecheck",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:deploy": "pnpm --filter web db:deploy",
    "db:seed": "pnpm --filter web db:seed",
    "gateway": "pnpm --filter gateway serve",
    "gateway:mcp": "pnpm --filter gateway mcp",
    "gateway:test": "pnpm --filter gateway test"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
